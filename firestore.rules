rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isChatMember(chatId) {
      return isSignedIn() &&
        request.auth.uid in
          get(/databases/$(database)/documents/chats/$(chatId)).data.users;
    }

    function isGroupMember(groupId) {
      return isSignedIn() &&
        request.auth.uid in
          get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    function isGroupAdmin(groupId) {
      return isSignedIn() &&
        request.auth.uid in
          get(/databases/$(database)/documents/groups/$(groupId)).data.admins;
    }

    // ---------- Users ----------
    // NOTE: reads are allowed for any signed-in user to support contact
    // discovery / search. Sensitive fields (e.g. fcmToken) should ideally be
    // moved to a private subcollection or only written/read server-side.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      // Owner may update their own doc but cannot change their uid.
      allow update: if isOwner(userId)
                    && request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(userId);
    }

    // ---------- Chats ----------
    match /chats/{chatId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.users;
      // Creator must be one of the participants on the new chat.
      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.users;
      // Members can update chat metadata (lastMessage, etc) but not the
      // participant list.
      allow update: if isSignedIn()
                    && request.auth.uid in resource.data.users
                    && request.resource.data.users == resource.data.users;
      allow delete: if isSignedIn() && request.auth.uid in resource.data.users;

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);
        // Sender cannot be spoofed.
        allow create: if isChatMember(chatId)
                      && request.resource.data.senderId == request.auth.uid;
        // senderId and createdAt are immutable; allows edits + read receipts.
        allow update: if isChatMember(chatId)
                      && request.resource.data.senderId == resource.data.senderId
                      && request.resource.data.createdAt == resource.data.createdAt;
        // Only the sender may delete their own message.
        allow delete: if isChatMember(chatId)
                      && resource.data.senderId == request.auth.uid;
      }
    }

    // ---------- Groups ----------
    match /groups/{groupId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;
      // New group: creator must be a member, an admin, and the declared creator.
      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.members
                    && request.auth.uid in request.resource.data.admins
                    && request.resource.data.creatorId == request.auth.uid;
      // Admins can change anything. Regular members may only update content
      // (e.g. lastMessage) — they cannot alter membership, admins, or creator.
      allow update: if isSignedIn()
                    && request.auth.uid in resource.data.members
                    && (
                      request.auth.uid in resource.data.admins ||
                      (
                        request.resource.data.members == resource.data.members &&
                        request.resource.data.admins == resource.data.admins &&
                        request.resource.data.creatorId == resource.data.creatorId
                      )
                    );
      // Only admins (or the creator) can delete the group.
      allow delete: if isSignedIn()
                    && (request.auth.uid in resource.data.admins
                        || request.auth.uid == resource.data.creatorId);

      match /messages/{messageId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId)
                      && request.resource.data.senderId == request.auth.uid;
        allow update: if isGroupMember(groupId)
                      && request.resource.data.senderId == resource.data.senderId
                      && request.resource.data.createdAt == resource.data.createdAt;
        // Message sender or a group admin may delete.
        allow delete: if isGroupMember(groupId)
                      && (resource.data.senderId == request.auth.uid
                          || isGroupAdmin(groupId));
      }
    }

    // ---------- Calls ----------
    match /calls/{callId} {
      allow read: if isSignedIn()
                  && (request.auth.uid == resource.data.callerId
                      || request.auth.uid == resource.data.receiverId);
      // Only the caller can initiate a call record.
      allow create: if isSignedIn()
                    && request.auth.uid == request.resource.data.callerId;
      allow update: if isSignedIn()
                    && (request.auth.uid == resource.data.callerId
                        || request.auth.uid == resource.data.receiverId);
      allow delete: if isSignedIn()
                    && (request.auth.uid == resource.data.callerId
                        || request.auth.uid == resource.data.receiverId);
    }

    // ---------- Blocks ----------
    // A user may only read and manage their own block records.
    match /blocks/{blockId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.blockerId;
      allow create: if isSignedIn()
                    && request.auth.uid == request.resource.data.blockerId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.blockerId;
    }

    // ---------- Statuses ----------
    match /statuses/{statusId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isSignedIn()
                            && request.auth.uid == resource.data.userId;
    }

    // ---------- Global Notifications ----------
    match /global_notifications/{notificationId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.user_id;
      allow write: if false; // Written by backend functions only.
    }
  }
}
